# ==============================================================================
# Voter Scrap & Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or the respective app folders (.env.local) as needed.

# ------------------------------------------------------------------------------
# 1. PYTHON OCR & AUDIT PIPELINE (core/)
# ------------------------------------------------------------------------------
# Google AI Studio API key (supports comma-separated list for automatic rotation)
GEMINI_API_KEY="AIzaSyYourStudioApiKeyHere..."

# Gemini model to use for OCR extraction (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Worker concurrency override (defaults to 2 workers per API key, or 5 for Vertex)
# MAX_WORKERS=4

# GCP Vertex AI settings (used if GEMINI_API_KEY is not set)
# VERTEX_LOCATION="us-central1"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Google Cloud Storage Buckets (for cloud pipeline)
INPUT_BUCKET="ocr-voter-lists-input"
OUTPUT_BUCKET="ocr-voter-lists-output"
DATASET_NAME="nagar_parishad"


# ------------------------------------------------------------------------------
# 2. NEXT.JS SEARCH APP (nextjs-search-app/)
# ------------------------------------------------------------------------------
# Public URL of the frontend portal
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# Google OAuth & Authentication (NextAuth.js)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3001"

# Primary Admin Email (granted full admin privileges on login)
ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional: Cloud Database Auto-Fetch for Vercel Serverless Deployments
# (If deploying on a standard VM or running locally, you DO NOT need these)
# GCS_BUCKET_NAME="your-custom-gcs-bucket-name"
# DATASET_NAME="nagar_parishad"
# GCP_PROJECT_ID="your-gcp-project-id"
# GCP_CLIENT_EMAIL="service-account@your-gcp-project-id.iam.gserviceaccount.com"
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

