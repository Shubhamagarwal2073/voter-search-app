generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id        Int     @id @default(autoincrement())
  name      String
  party     String
  ward      String
  phone     String?
  whatsapp  String?
  manifesto String?
  imageUrl  String?
}

model WardStat {
  id      Int    @id @default(autoincrement())
  ward    Int    @unique
  total   Int    @default(0)
  male    Int    @default(0)
  female  Int    @default(0)
  other   Int    @default(0)
  missing Int[]
  status  String @default("VERIFIED")
}

model Voter {
  voter_id          String  @id
  ward              Int
  serial_number     Int
  name_hi           String?
  relative_name_hi  String?
  house_number      String?
  gender            String?

}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  role          String  @default("paid")
  allowed_wards String?
}
